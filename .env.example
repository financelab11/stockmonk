# SimFin API key. Server/build only. Never expose with NEXT_PUBLIC_.
SIMFIN_API_KEY=

# Canonical site URL used for metadata, sitemap and RSS.
NEXT_PUBLIC_SITE_URL=https://stockmonk.app

# Optional privacy-friendly analytics (Plausible). Leave blank to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Supabase (public project URL and publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key for ingestion/sync scripts. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Direct database fallback for sync/apply scripts (server-only).
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
SUPABASE_DB_USER=postgres.fqzfmvnmmiisvtgnsyqa
