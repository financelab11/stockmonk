# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated QA artifacts
.lighthouseci/
test-results/
playwright-report/
public/screenshots/

# ingestion cache (re-downloadable)
/data/raw/
/data/india/raw/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# GCC scrape cache (re-downloadable)
/data/gcc/raw/

# Forward growth ranker raw ingestion
/data/growth-ranker/raw/
/data/growth-ranker/refinitiv-top.json
# Earnings press releases (regenerate with pnpm ingest:earnings)
/data/earnings/

# Screener crawl cache (resumable, regenerated on demand)
/data/india/.screener-cache/

# Yahoo price cache for the earnings tracker
/data/india/.price-cache/

# Performance measurement artefacts
/.chrome-test/
/.perf/
/.lighthouse-*.json
/.lighthouseci*/

# One-off Lighthouse probe output
/.lh-test-*.json
/.lighthouse-test.json
/.lighthouse-external.json
/.lighthouse-prod.json
