# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated QA artifacts
.lighthouseci/
test-results/
playwright-report/
public/screenshots/

# ingestion cache (re-downloadable)
/data/raw/

# CON is a reserved Windows device name; the public ticker stays CON but the
# evidence and logo files are stored with a trailing underscore.
/public/data/v2/companies/CON.json
/public/logos/CON
/public/logos/CON.png

# Score-only SEC statements are versioned (they change quarterly). The larger
# daily Yahoo outputs are rebuilt in CI and only the public score artifacts are
# committed.
/data/score-inputs/**/data.json
/data/score-inputs/**/prices.json
/data/score-inputs/**/consensus.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Earnings press releases (regenerate with pnpm ingest:earnings)
/data/earnings/

# Performance measurement artefacts
/.chrome-test/
/.perf/
/.lighthouse-*.json
/.lighthouseci*/

# One-off Lighthouse probe output
/.lh-test-*.json
/.lighthouse-test.json
/.lighthouse-external.json
/.lighthouse-prod.json
