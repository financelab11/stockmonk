{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 90000,
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/discover",
        "http://127.0.0.1:3000/discover/all-stocks",
        "http://127.0.0.1:3000/newsfeed",
        "http://127.0.0.1:3000/framework",
        "http://127.0.0.1:3000/stocks/NVDA",
        "http://127.0.0.1:3000/stocks/MSFT",
        "http://127.0.0.1:3000/stocks/JPM"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox --disable-gpu"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
        "total-blocking-time": ["error", { "maxNumericValue": 500 }],
        "total-byte-weight": ["warn", { "maxNumericValue": 2800000 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
