{
  "name": "stockmonk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm validate:content && next build",
    "validate:content": "tsx scripts/validate-content.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lhci": "lhci autorun && lhci autorun --config=lighthouserc.desktop.json",
    "lhci:mobile": "lhci autorun",
    "lhci:desktop": "lhci autorun --config=lighthouserc.desktop.json",
    "ingest:edgar": "tsx scripts/ingest-edgar.ts",
    "ingest:simfin": "tsx scripts/ingest-simfin.ts",
    "ingest:consensus": "tsx scripts/ingest-consensus.ts",
    "ingest:segments": "tsx scripts/ingest-segments.ts",
    "build:data": "tsx scripts/build-public-data.ts",
    "assets": "node scripts/generate-brand-assets.cjs",
    "refresh": "pnpm ingest:edgar && pnpm ingest:simfin && pnpm ingest:consensus && pnpm ingest:segments && pnpm build:data"
  },
  "dependencies": {
    "@serwist/next": "^9.5.13",
    "@serwist/turbopack": "^9.5.13",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "fast-xml-parser": "^5.12.0",
    "fuse.js": "^7.5.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.13",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.34.9"
}
