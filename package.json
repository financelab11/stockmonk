{
  "name": "stockmonk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm validate:content && pnpm validate:india-content && pnpm validate:gcc-content && pnpm build:screener && next build",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:india-content": "tsx scripts/validate-india-content.ts",
    "validate:gcc-content": "tsx scripts/validate-gcc-content.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lhci": "lhci autorun && lhci autorun --config=lighthouserc.desktop.json",
    "lhci:mobile": "lhci autorun",
    "lhci:desktop": "lhci autorun --config=lighthouserc.desktop.json",
    "ingest:edgar": "tsx scripts/ingest-edgar.ts",
    "ingest:simfin": "tsx scripts/ingest-simfin.ts",
    "ingest:bulk": "tsx scripts/ingest-simfin-bulk.ts",
    "ingest:fallback": "tsx scripts/ingest-fallback.ts",
    "ingest:consensus": "tsx scripts/ingest-consensus.ts",
    "ingest:segments": "tsx scripts/ingest-segments.ts",
    "ingest:benchmark": "tsx scripts/ingest-benchmark.ts",
    "ingest:india": "tsx scripts/ingest-india.ts",
    "ingest:gcc": "tsx scripts/ingest-gcc.ts",
    "build:gcc": "tsx scripts/build-gcc-data.ts",
    "build:india": "tsx scripts/build-india-data.ts",
    "build:growth-ranker": "tsx scripts/build-growth-ranker-estimates.ts",
    "sync:supabase": "tsx scripts/sync-supabase.ts",
    "sync:supabase:direct": "tsx scripts/sync-supabase-direct.ts",
    "context:update": "tsx scripts/update-context.ts",
    "india:stories:briefs": "tsx scripts/build-india-story-briefs.ts",
    "india:stories:materialize": "tsx scripts/materialize-india-stories.ts",
    "india:stories:index": "tsx scripts/build-india-stories-index.ts",
    "backfill:filings": "tsx scripts/backfill-filings.ts",
    "audit:generated": "tsx scripts/audit-generated.ts",
    "audit:stories": "tsx scripts/audit-stories.ts",
    "audit:india-stories": "tsx scripts/audit-india-stories.ts",
    "stories:briefs": "tsx scripts/build-story-briefs.ts",
    "stories:materialize": "tsx scripts/materialize-stories.ts",
    "stories:index": "tsx scripts/build-stories-index.ts",
    "build:data": "tsx scripts/build-public-data.ts",
    "audit:freshness": "tsx scripts/audit-freshness.ts",
    "refresh:prices": "tsx scripts/refresh-us-prices.ts",
    "refresh:ranker": "tsx scripts/refresh-growth-ranker-raw.ts",
    "chips:rebuild": "tsx scripts/recompute-us-factor-chips.ts",
    "build:screener": "tsx scripts/build-screener-data.ts",
    "assets": "node scripts/generate-brand-assets.cjs",
    "refresh": "pnpm ingest:edgar && pnpm ingest:simfin && pnpm ingest:fallback && pnpm backfill:filings && pnpm ingest:consensus && pnpm ingest:segments && pnpm ingest:benchmark && pnpm build:data && pnpm build:screener"
  },
  "dependencies": {
    "@serwist/next": "^9.5.13",
    "@serwist/turbopack": "^9.5.13",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "fast-xml-parser": "^5.12.0",
    "fuse.js": "^7.5.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.13",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.34.9"
}
