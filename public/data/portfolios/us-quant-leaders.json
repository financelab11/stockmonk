ars.","The current review proposes 1 changes. They are candidates for the next rebalance and have not been executed."]}],"constituentNotes":[{"ticker":"MU","note":"Information Technology · $649.5B market cap · 3.9% weight · +156.0% 1Y. Full Stockmonk research report available."},{"ticker":"LKNCY","note":"Consumer Discretionary · $10.8B market cap · 3.8% weight · +3.9% 1Y. Quantitative score evidence available; full research report not published."},{"ticker":"PLMR","note":"Financials · $4.4B market cap · 3.5% weight · +36.1% 1Y. Full Stockmonk research report available."},{"ticker":"APA","note":"Energy · $15.3B market cap · 3.4% weight · +94.3% 1Y. Quantitative score evidence available; full research report not published."},{"ticker":"ATAT","note":"Consumer Discretionary · $5.5B market cap · 3.4% weight · +11.4% 1Y. Quantitative score evidence available; full research report not published."},{"ticker":"APH","note":"Information Technology · $175.0B market cap · 3.4% weight · +3.6% 1Y. Full Stockmonk research report available."},{"ticker":"NVDA","note":"Information Technology · $3.5T market cap · 3.4% weight · -17.6% 1Y. Full Stockmonk research report available."},{"ticker":"MRX","note":"Financials · $4.3B market cap · 3.4% weight · +76.0% 1Y. Quantitative score evidence available; full research report not published."}]}}